{
  "name": "payment-ledger-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:setup": "tsx scripts/setup.ts",
    "reconcile": "tsx cli/reconcile.ts",
    "demo": "tsx scripts/demo.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "sign": "tsx scripts/sign.ts",
    "package": "python3 scripts/package.py",
    "explain": "tsx scripts/explain.ts",
    "format": "prettier --write src cli scripts tests package.json tsconfig.json eslint.config.js",
    "format:check": "prettier --check src cli scripts tests package.json tsconfig.json eslint.config.js"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "eslint": "10.12.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1"
  }
}
